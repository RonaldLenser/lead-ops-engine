# Copy to backend/.env and adjust. backend/.env is gitignored; never commit it.
# Settings are added here only when code uses them.

# ----- App -----
# local = readable colored logs; test and prod = JSON logs
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----- Database -----
# Matches infra/docker-compose.yml (host port 5434). Start it with:
#   docker compose -f infra/docker-compose.yml up -d db
# The app connects as leadops_app, which can read and write rows but cannot
# change the schema. These passwords are local-only; prod refuses to start with them.
DATABASE_URL=postgresql+asyncpg://leadops_app:leadops_app_dev@localhost:5434/leadops
# Alembic runs as the schema owner. Only migrations use this.
MIGRATION_DATABASE_URL=postgresql+asyncpg://leadops_migrator:leadops_migrator_dev@localhost:5434/leadops
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=5
# Logs every SQL statement. Local debugging only; rejected when APP_ENV=prod.
DB_ECHO=false

# ----- Health -----
READINESS_TIMEOUT_SECONDS=2

# ----- Intake -----
# Request body cap in bytes (32 KB)
MAX_REQUEST_BODY_BYTES=32768
# Region for phone numbers typed without a country code
DEFAULT_PHONE_REGION=US
# Raw inbound payloads are purged after this many days (purge job arrives in M9)
RAW_EVENT_RETENTION_DAYS=30

# ----- Webhooks -----
# JSON: source name -> list of shared secrets (32+ characters each; list several to rotate).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRETS={}
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ----- Client IP -----
# JSON list of reverse-proxy networks allowed to set X-Forwarded-For. Empty = trust none.
# Production behind Caddy on the Compose network, for example: ["172.18.0.0/16"]
TRUSTED_PROXY_CIDRS=[]

# ----- Rate limits (requests per minute, per process) -----
RATE_LIMIT_INTAKE_PER_IP=60
RATE_LIMIT_INTAKE_PER_API_KEY=120
RATE_LIMIT_WEBHOOK_PER_SOURCE=120
